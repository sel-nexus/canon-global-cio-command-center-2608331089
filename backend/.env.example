# Local development only; replace all credentials for deployment.
DATABASE_URL=postgresql+psycopg://canon:canon-dev-only@localhost:5432/postgres
DB_NAME=canon_cio
JWT_SECRET=dev-secret-change-in-production-at-least-32-characters
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173
# Dedicated test database; tests never create or drop a database.
TEST_DATABASE_URL=postgresql+psycopg://canon:canon-dev-only@localhost:5432/canon_cio_test
# Enable only after provider, data sharing and security review.
AI_ENABLED=false
AI_ENDPOINT=https://approved-provider.example.com/v1/chat/completions
AI_MODEL=approved-model
AI_API_KEY=replace-with-approved-provider-key
